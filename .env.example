# ------------------------------------------------------------------
# TeamFly Brasil — variáveis de ambiente
# Copie para .env e preencha os valores.
# ------------------------------------------------------------------

# URL pública do site (usada em SEO, sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Banco de dados (SQLite — arquivo local, zero configuração)
DATABASE_URL="file:./dev.db"

# Autenticação (JWT) — gere um segredo forte: openssl rand -base64 32
JWT_SECRET="troque-por-um-segredo-forte"

# Google Analytics (opcional)
NEXT_PUBLIC_GA_ID=""

# ------------------------------------------------------------------
# Envio de e-mail dos formulários (Nodemailer / SMTP)
# Para usar o Gmail:
#   1. Ative a verificação em 2 etapas na conta teamflybrasil@gmail.com
#   2. Gere uma "Senha de app" em https://myaccount.google.com/apppasswords
#   3. Cole a senha de 16 letras em SMTP_PASS (sem espaços)
# Se deixar em branco, os formulários continuam salvando no painel (sem e-mail).
# ------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="teamflybrasil@gmail.com"
SMTP_PASS=""
CONTACT_TO_EMAIL="teamflybrasil@gmail.com"
