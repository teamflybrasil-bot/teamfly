# ==================================================================
# TeamFly Brasil — variáveis de PRODUÇÃO (Vercel)
# Configure estas variáveis no painel da Vercel (Settings → Environment Variables).
# NÃO comitar valores reais.
# ==================================================================

# Domínio público (SEM barra no final)
NEXT_PUBLIC_SITE_URL="https://teamflybrasil.com.br"

# Banco de dados — Neon (PostgreSQL)
# Use a "Pooled connection" no DATABASE_URL e a direta no DIRECT_URL.
DATABASE_URL="postgresql://...-pooler.../neondb?sslmode=require"
DIRECT_URL="postgresql://.../neondb?sslmode=require"

# Armazenamento de imagens — Vercel Blob
# A Vercel injeta este token automaticamente ao criar o Blob store no projeto.
BLOB_READ_WRITE_TOKEN=""

# Segredo do login do painel — gere um forte: openssl rand -base64 32
JWT_SECRET="COLOQUE_UM_SEGREDO_LONGO_E_ALEATORIO_AQUI"

# E-mail dos formulários (Gmail: "Senha de app")
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="teamflybrasil@gmail.com"
SMTP_PASS=""
CONTACT_TO_EMAIL="teamflybrasil@gmail.com"

# Google Analytics (opcional)
NEXT_PUBLIC_GA_ID=""
