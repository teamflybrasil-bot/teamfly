# ==================================================================
# TeamFly Brasil — variáveis de PRODUÇÃO (servidor / Hostinger VPS)
# Copie para .env no servidor e preencha. NÃO comitar este arquivo.
# ==================================================================

# Ambiente
NODE_ENV="production"

# Domínio público (usado em SEO, sitemap, OpenGraph) — SEM barra no final
NEXT_PUBLIC_SITE_URL="https://teamflybrasil.com.br"

# Banco SQLite (arquivo no disco do servidor — persistente)
DATABASE_URL="file:./prod.db"

# Pasta das fotos enviadas pelo painel (persistente no servidor)
# Deixe em branco para usar ./uploads na raiz do projeto, ou aponte p/ um caminho absoluto.
UPLOAD_DIR=""

# Segredo do login do painel — GERE UM FORTE: openssl rand -base64 32
JWT_SECRET="COLOQUE_UM_SEGREDO_LONGO_E_ALEATORIO_AQUI"

# Admin inicial (criado no primeiro deploy pelo seed)
ADMIN_EMAIL="teamflybrasil@gmail.com"
ADMIN_PASSWORD="TROQUE_POR_UMA_SENHA_FORTE"

# Não popular os dados de exemplo (fica limpo para você preencher). Use "0".
SEED_EXAMPLES="0"

# E-mail dos formulários (Gmail: use uma "Senha de app")
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="teamflybrasil@gmail.com"
SMTP_PASS=""
CONTACT_TO_EMAIL="teamflybrasil@gmail.com"

# Google Analytics (opcional)
NEXT_PUBLIC_GA_ID=""
